{
  "openapi": "3.0.0",
  "info": {
    "title": "Fonik API",
    "description": "REST API for user accounts, phone listings, and shopping baskets.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://fonik-backend.onrender.com",
      "description": "Production server"
    }
  ],
  "tags": [
    { "name": "Auth", "description": "Registration and session management" },
    { "name": "Phones", "description": "Phone listings and basket operations" },
    { "name": "Users", "description": "User profiles and user-related listings" }
  ],
  "paths": {
    "/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Register a user",
        "description": "Creates an account and starts a session. Session credentials are set as HTTP-only cookies.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RegisterRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User registered; session cookies are set.",
            "headers": {
              "Set-Cookie": { "$ref": "#/components/headers/SessionCookies" }
            },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/User" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Log in",
        "description": "Creates a new session and sets HTTP-only session cookies. A user's previous session is removed.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful; session cookies are set.",
            "headers": {
              "Set-Cookie": { "$ref": "#/components/headers/SessionCookies" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LoginResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": {
            "description": "Invalid email or password.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Log out",
        "description": "Deletes the current session when a session cookie is present and clears the session cookies.",
        "responses": {
          "204": { "description": "Logged out; session cookies are cleared." },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "Refresh the session",
        "description": "Uses the refreshToken and sessionId cookies to rotate the session and set new cookies.",
        "security": [{ "refreshTokenCookie": [], "sessionIdCookie": [] }],
        "responses": {
          "200": {
            "description": "Session refreshed; new session cookies are set.",
            "headers": {
              "Set-Cookie": { "$ref": "#/components/headers/SessionCookies" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Message" },
                "example": { "message": "Refresh success!" }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, or expired session credentials.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/phones": {
      "get": {
        "tags": ["Phones"],
        "summary": "List phone listings",
        "description": "Returns a paginated public catalog. When authenticated, the current user's own listings are excluded.",
        "security": [{ "accessTokenCookie": [], "sessionIdCookie": [] }, {}],
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/PhonePerPage" }
        ],
        "responses": {
          "200": {
            "description": "Paginated phone listings.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PhonePage" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "post": {
        "tags": ["Phones"],
        "summary": "Create a phone listing",
        "description": "Creates a listing for the authenticated user. Send the photo as a multipart file; accepted image types are JPG, PNG, WEBP, or GIF (up to 2 MB).",
        "security": [{ "accessTokenCookie": [], "sessionIdCookie": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": { "$ref": "#/components/schemas/CreatePhoneRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Listing created.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Phone" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/phones/my": {
      "get": {
        "tags": ["Phones"],
        "summary": "List my phone listings",
        "security": [{ "accessTokenCookie": [], "sessionIdCookie": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/PhonePerPage" }
        ],
        "responses": {
          "200": {
            "description": "Paginated listings owned by the current user.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PhonePage" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/phones/basket": {
      "get": {
        "tags": ["Phones"],
        "summary": "Get my basket",
        "description": "Returns the phone listings currently in the authenticated user's basket.",
        "security": [{ "accessTokenCookie": [], "sessionIdCookie": [] }],
        "responses": {
          "200": {
            "description": "Basket phone listings.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Phone" }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": {
            "description": "User not found.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/phones/{phoneId}": {
      "parameters": [{ "$ref": "#/components/parameters/PhoneId" }],
      "get": {
        "tags": ["Phones"],
        "summary": "Get a phone listing",
        "responses": {
          "200": {
            "description": "Phone listing.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Phone" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": {
            "description": "Phone not found.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "patch": {
        "tags": ["Phones"],
        "summary": "Update a phone listing",
        "description": "Updates a listing owned by the authenticated user. Send a replacement photo as a multipart file (up to 2 MB).",
        "security": [{ "accessTokenCookie": [], "sessionIdCookie": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": { "$ref": "#/components/schemas/UpdatePhoneRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated listing.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Phone" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": {
            "description": "Phone not found or not owned by the current user.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "delete": {
        "tags": ["Phones"],
        "summary": "Delete a phone listing",
        "security": [{ "accessTokenCookie": [], "sessionIdCookie": [] }],
        "responses": {
          "200": {
            "description": "Listing deleted.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Message" },
                "example": { "message": "Phone listing deleted successfully" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": {
            "description": "The listing belongs to another user.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "404": {
            "description": "Phone not found.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/phones/{phoneId}/basket": {
      "parameters": [{ "$ref": "#/components/parameters/PhoneId" }],
      "post": {
        "tags": ["Phones"],
        "summary": "Add a phone to my basket",
        "security": [{ "accessTokenCookie": [], "sessionIdCookie": [] }],
        "responses": {
          "200": {
            "description": "Phone added to basket.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Message" },
                "example": { "message": "Phone added to basket" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "delete": {
        "tags": ["Phones"],
        "summary": "Remove a phone from my basket",
        "security": [{ "accessTokenCookie": [], "sessionIdCookie": [] }],
        "responses": {
          "200": {
            "description": "Phone removed from basket.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Message" },
                "example": { "message": "Phone removed from basket" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/users": {
      "get": {
        "tags": ["Users"],
        "summary": "List users",
        "description": "Returns public user fields only; email, password, and basket contents are omitted. Defaults: page 1, 20 users per page; maximum 100.",
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/UserPerPage" }
        ],
        "responses": {
          "200": {
            "description": "Paginated public users.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserPage" }
              }
            }
          },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/users/me": {
      "get": {
        "tags": ["Users"],
        "summary": "Get my profile",
        "security": [{ "accessTokenCookie": [], "sessionIdCookie": [] }],
        "responses": {
          "200": {
            "description": "Current user's profile.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CurrentUserResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": {
            "description": "User not found.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "patch": {
        "tags": ["Users"],
        "summary": "Update my profile",
        "description": "Updates the username and/or avatar. Username must be 2-32 characters. Avatar images must be at most 2 MB.",
        "security": [{ "accessTokenCookie": [], "sessionIdCookie": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": { "$ref": "#/components/schemas/UpdateProfileRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated profile.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CurrentUserResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": {
            "description": "User not found.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/users/avatar": {
      "patch": {
        "tags": ["Users"],
        "summary": "Update my avatar",
        "description": "Uploads an image file (JPG, PNG, WEBP, or GIF; up to 2 MB) using the avatar field.",
        "security": [{ "accessTokenCookie": [], "sessionIdCookie": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": { "$ref": "#/components/schemas/AvatarUploadRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Avatar updated.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AvatarResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/users/me/phones-in-basket": {
      "get": {
        "tags": ["Users"],
        "summary": "List my basket with pagination",
        "security": [{ "accessTokenCookie": [], "sessionIdCookie": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/UserBasketPerPage" }
        ],
        "responses": {
          "200": {
            "description": "Paginated basket listings.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PhonePage" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/users/basket/{phoneId}": {
      "parameters": [{ "$ref": "#/components/parameters/PhoneId" }],
      "post": {
        "tags": ["Users"],
        "summary": "Add a phone to my basket",
        "description": "Alias for POST /phones/{phoneId}/basket.",
        "security": [{ "accessTokenCookie": [], "sessionIdCookie": [] }],
        "responses": {
          "200": {
            "description": "Phone added to basket.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Message" },
                "example": { "message": "Phone added to basket" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "delete": {
        "tags": ["Users"],
        "summary": "Remove a phone from my basket",
        "description": "Alias for DELETE /phones/{phoneId}/basket.",
        "security": [{ "accessTokenCookie": [], "sessionIdCookie": [] }],
        "responses": {
          "200": {
            "description": "Phone removed from basket.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Message" },
                "example": { "message": "Phone removed from basket" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/users/{id}/phones": {
      "get": {
        "tags": ["Users"],
        "summary": "List a user's phone listings",
        "parameters": [
          { "$ref": "#/components/parameters/UserId" },
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/UserBasketPerPage" }
        ],
        "responses": {
          "200": {
            "description": "Paginated listings for the specified user.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PhonePage" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/users/{id}": {
      "get": {
        "tags": ["Users"],
        "summary": "Get a public user profile",
        "description": "Email, password, and basket contents are not returned.",
        "parameters": [{ "$ref": "#/components/parameters/UserId" }],
        "responses": {
          "200": {
            "description": "Public user profile.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PublicUserResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": {
            "description": "User not found.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "accessTokenCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "accessToken",
        "description": "HTTP-only access token cookie set by registration or login."
      },
      "refreshTokenCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "refreshToken",
        "description": "HTTP-only refresh token cookie set by registration or login."
      },
      "sessionIdCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sessionId",
        "description": "HTTP-only session ID cookie set by registration or login."
      }
    },
    "parameters": {
      "Page": {
        "name": "page",
        "in": "query",
        "description": "Page number (minimum 1).",
        "schema": { "type": "integer", "minimum": 1, "default": 1 }
      },
      "PhonePerPage": {
        "name": "perPage",
        "in": "query",
        "description": "Phone listings per page (1-50; default 12).",
        "schema": { "type": "integer", "minimum": 1, "maximum": 50, "default": 12 }
      },
      "UserPerPage": {
        "name": "perPage",
        "in": "query",
        "description": "Users per page (default 20; maximum 100).",
        "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
      },
      "UserBasketPerPage": {
        "name": "perPage",
        "in": "query",
        "description": "Items per page (1-100; default 12).",
        "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 12 }
      },
      "PhoneId": {
        "name": "phoneId",
        "in": "path",
        "required": true,
        "description": "MongoDB ObjectId of a phone listing.",
        "schema": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{24}$",
          "example": "507f1f77bcf86cd799439011"
        }
      },
      "UserId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "MongoDB ObjectId of a user.",
        "schema": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{24}$",
          "example": "507f1f77bcf86cd799439011"
        }
      },
      "SessionIdCookie": {
        "name": "sessionId",
        "in": "cookie",
        "required": true,
        "description": "Session ID cookie set by login or registration.",
        "schema": { "type": "string" }
      },
      "RefreshTokenCookie": {
        "name": "refreshToken",
        "in": "cookie",
        "required": true,
        "description": "Refresh token cookie set by login or registration.",
        "schema": { "type": "string" }
      }
    },
    "headers": {
      "SessionCookies": {
        "description": "Sets accessToken, refreshToken, and sessionId as HTTP-only, secure, SameSite=None cookies.",
        "schema": { "type": "string" }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request data.",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
        }
      },
      "Unauthorized": {
        "description": "Authentication is missing or invalid.",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
        }
      },
      "ServerError": {
        "description": "Unexpected server error.",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": { "message": { "type": "string", "example": "Phone not found" } }
      },
      "Message": {
        "type": "object",
        "required": ["message"],
        "properties": { "message": { "type": "string" } }
      },
      "RegisterRequest": {
        "type": "object",
        "required": ["username", "email", "password"],
        "properties": {
          "username": {
            "type": "string",
            "minLength": 2,
            "maxLength": 32,
            "example": "Alex"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 64,
            "example": "alex@example.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 8,
            "maxLength": 64,
            "example": "strongPassword"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 64,
            "example": "alex@example.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 8,
            "maxLength": 64,
            "example": "strongPassword"
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "_id": { "type": "string", "example": "507f1f77bcf86cd799439011" },
          "username": { "type": "string", "example": "Alex" },
          "email": { "type": "string", "format": "email", "example": "alex@example.com" },
          "avatar": { "type": "string", "format": "uri" },
          "phonesInBasket": { "type": "array", "items": { "type": "string" } },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "__v": { "type": "integer" }
        }
      },
      "PublicUser": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "username": { "type": "string" },
          "avatar": { "type": "string", "format": "uri" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "CurrentUserResponse": {
        "type": "object",
        "required": ["user"],
        "properties": { "user": { "$ref": "#/components/schemas/User" } }
      },
      "PublicUserResponse": {
        "type": "object",
        "required": ["user"],
        "properties": { "user": { "$ref": "#/components/schemas/PublicUser" } }
      },
      "LoginResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/User" },
          {
            "type": "object",
            "properties": {
              "accessToken": {
                "type": "string",
                "description": "Also set as an HTTP-only cookie."
              },
              "refreshToken": {
                "type": "string",
                "description": "Also set as an HTTP-only cookie."
              },
              "sessionId": {
                "type": "string",
                "description": "Also set as an HTTP-only cookie."
              },
              "password": {
                "type": "string",
                "description": "The current login handler returns the stored bcrypt hash in this field. This is sensitive and should be removed from the response."
              },
              "phonesInBasket": { "type": "array", "items": { "type": "string" } },
              "__v": { "type": "integer" }
            }
          }
        ]
      },
      "Phone": {
        "type": "object",
        "required": [
          "_id",
          "name",
          "description",
          "price",
          "photo",
          "storage",
          "battery",
          "inUse",
          "conditions",
          "author",
          "userId"
        ],
        "properties": {
          "_id": { "type": "string", "example": "507f1f77bcf86cd799439011" },
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 48,
            "example": "Phone model"
          },
          "description": { "type": "string", "minLength": 10, "maxLength": 4000 },
          "price": { "type": "integer", "minimum": 0, "example": 499 },
          "photo": { "type": "string", "format": "uri" },
          "storage": { "type": "integer", "enum": [8, 16, 32, 64, 128, 256] },
          "battery": { "type": "string", "enum": ["100%", "85%-99%", "Below 85%"] },
          "inUse": {
            "type": "string",
            "enum": ["Under 6 months", "6-12 months", "1-2 years", "2+ years"]
          },
          "conditions": { "type": "string", "enum": ["Perfect", "Good", "Damaged"] },
          "author": { "type": "string", "example": "Alex" },
          "userId": { "type": "string", "example": "507f1f77bcf86cd799439011" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "__v": { "type": "integer" }
        }
      },
      "PhonePage": {
        "type": "object",
        "required": ["page", "perPage", "totalPhones", "totalPages", "phones"],
        "properties": {
          "page": { "type": "integer" },
          "perPage": { "type": "integer" },
          "totalPhones": { "type": "integer" },
          "totalPages": { "type": "integer" },
          "phones": { "type": "array", "items": { "$ref": "#/components/schemas/Phone" } }
        }
      },
      "UserPage": {
        "type": "object",
        "required": ["page", "perPage", "totalUsers", "totalPages", "users"],
        "properties": {
          "page": { "type": "integer" },
          "perPage": { "type": "integer" },
          "totalUsers": { "type": "integer" },
          "totalPages": { "type": "integer" },
          "users": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/PublicUser" }
          }
        }
      },
      "CreatePhoneRequest": {
        "type": "object",
        "required": [
          "name",
          "description",
          "price",
          "photo",
          "author",
          "storage",
          "battery",
          "inUse",
          "conditions"
        ],
        "properties": {
          "name": { "type": "string", "minLength": 3, "maxLength": 48 },
          "description": { "type": "string", "minLength": 10, "maxLength": 4000 },
          "price": { "type": "integer", "minimum": 0 },
          "photo": {
            "type": "string",
            "format": "binary",
            "description": "Image upload, maximum 2 MB."
          },
          "author": { "type": "string", "minLength": 2, "maxLength": 50 },
          "storage": { "type": "integer", "enum": [8, 16, 32, 64, 128, 256] },
          "battery": { "type": "string", "enum": ["100%", "85%-99%", "Below 85%"] },
          "inUse": {
            "type": "string",
            "enum": ["Under 6 months", "6-12 months", "1-2 years", "2+ years"]
          },
          "conditions": { "type": "string", "enum": ["Perfect", "Good", "Damaged"] }
        }
      },
      "UpdatePhoneRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 3, "maxLength": 48 },
          "description": { "type": "string", "minLength": 10, "maxLength": 4000 },
          "price": { "type": "integer", "minimum": 0 },
          "photo": {
            "type": "string",
            "format": "binary",
            "description": "Replacement image upload, maximum 2 MB."
          },
          "author": { "type": "string", "minLength": 2, "maxLength": 50 },
          "storage": { "type": "integer", "enum": [8, 16, 32, 64, 128, 256] },
          "battery": { "type": "string", "enum": ["100%", "85%-99%", "Below 85%"] },
          "inUse": {
            "type": "string",
            "enum": ["Under 6 months", "6-12 months", "1-2 years", "2+ years"]
          },
          "conditions": { "type": "string", "enum": ["Perfect", "Good", "Damaged"] }
        }
      },
      "UpdateProfileRequest": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "username": { "type": "string", "minLength": 2, "maxLength": 32 },
          "avatar": {
            "type": "string",
            "format": "binary",
            "description": "Image upload, maximum 2 MB."
          }
        }
      },
      "AvatarUploadRequest": {
        "type": "object",
        "required": ["avatar"],
        "properties": {
          "avatar": {
            "type": "string",
            "format": "binary",
            "description": "JPG, PNG, WEBP, or GIF image; maximum 2 MB."
          }
        }
      },
      "AvatarResponse": {
        "type": "object",
        "required": ["url"],
        "properties": { "url": { "type": "string", "format": "uri" } }
      }
    }
  }
}
